# API Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/fsw_reels
REDIS_URL=redis://localhost:6379/0

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_id_here

# Google Accounts (comma separated if multiple)
GOOGLE_ACCOUNTS_JSON='[{"email": "account1@gmail.com", "password": "password1", "recovery_email": "recovery1@gmail.com"}]'

# Instagram Configuration
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Google Sheets
GOOGLE_SHEETS_ID=your_sheet_id

# Storage
STORAGE_PATH=./storage

# OpenAI / Gemini API (Optional if using Playwright for everything)
GEMINI_API_KEY=your_gemini_key
